{
  "name": "album-corse",
  "private": true,
  "version": "1.0.0",
  "description": "Album photo et vidéo du voyage en Corse (octobre 2026)",
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --config worker/wrangler.toml --port 8787 --persist-to .wrangler/state",
    "dev:site": "node scripts/serve.mjs",
    "import": "node scripts/import.mjs",
    "test:api": "node scripts/test-api.mjs",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "set-api-url": "node scripts/set-api-url.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "contours": "node scripts/gen-contours.mjs"
  },
  "devDependencies": {
    "exifr": "7.1.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "sharp": "0.35.5",
    "sortablejs": "1.15.7",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
